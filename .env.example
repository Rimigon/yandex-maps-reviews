APP_NAME="Отзывы с Яндекс.Карт"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://127.0.0.1:8000

APP_LOCALE=ru_RU
APP_FALLBACK_LOCALE=ru
APP_FAKER_LOCALE=ru_RU

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# Локально по умолчанию SQLite. Для docker-compose переменные задаются
# в compose.yaml (MySQL в контейнере db).
DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=reviews
# DB_USERNAME=reviews
# DB_PASSWORD=secret

# ---------------------------------------------------------------------------
# docker-compose
# ---------------------------------------------------------------------------
# Эти переменные читает только docker compose (в файле compose.yaml), а не
# Laravel внутри контейнера. Префикс DOCKER_ нужен, чтобы они не конфликтовали
# с настройками локального запуска выше: у одного и того же .env две роли.

# Порт, на который смотрит reverse proxy или сам пользователь.
APP_PORT=8080

# Адрес, по которому приложение открывается снаружи, и домен для сессионной
# аутентификации. На VPS укажите реальный адрес, иначе вход вернёт 500
# «Session store not set on request».
# DOCKER_APP_URL=https://reviews.example.com
# DOCKER_SANCTUM_DOMAINS=reviews.example.com

# Доступ к MySQL внутри compose. На чужом сервере смените пароли.
# DOCKER_DB_DATABASE=reviews
# DOCKER_DB_USERNAME=reviews
# DOCKER_DB_PASSWORD=secret
# DOCKER_DB_ROOT_PASSWORD=root

# Порт MySQL наружу нужен только если подключаетесь к базе извне сервера;
# по умолчанию порт не публикуется.
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

# Sanctum включает сессионную аутентификацию только для запросов со своего
# домена. Для локального artisan serve — localhost:8000, для docker-compose —
# localhost:8080; на боевом домене укажите свой адрес.
SANCTUM_STATEFUL_DOMAINS=localhost:8000,127.0.0.1:8000

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database

MAIL_MAILER=log

# Пользователь, которого создаёт сидер (регистрации в задании нет).
SEED_USER_EMAIL=test@example.com
SEED_USER_PASSWORD=password

# ---------------------------------------------------------------------------
# Парсер Яндекс.Карт
# ---------------------------------------------------------------------------

# Сколько страниц отзывов забирать: Яндекс отдаёт страницы по 50 и обрывает
# выдачу примерно на 600 отзывах.
YANDEX_MAPS_MAX_PAGES=12

# Пауза между запросами к Яндексу (мс) и повторы при сбоях.
YANDEX_MAPS_THROTTLE_MIN_MS=250
YANDEX_MAPS_THROTTLE_MAX_MS=900
YANDEX_MAPS_RETRY_TIMES=3
YANDEX_MAPS_RETRY_SLEEP_MS=800

# Список User-Agent'ов через вертикальную черту: на каждую сессию парсинга
# берётся один случайный.
YANDEX_MAPS_USER_AGENTS=

# Прокси через запятую: http://user:pass@host:port
YANDEX_MAPS_PROXIES=

# Сколько секунд считать выгруженные данные свежими: пока не истекло,
# повторный парсинг без принудительного запуска не выполняется.
YANDEX_MAPS_CACHE_TTL=900

# Очередь для фоновых выгрузок.
YANDEX_MAPS_QUEUE=default

# Запасной путь: сбор отзывов headless-браузером, если Яндекс закрыл прямой
# доступ (нужны node и playwright-core в browser-fallback).
YANDEX_MAPS_BROWSER_FALLBACK=false
YANDEX_MAPS_BROWSER_COMMAND=node
YANDEX_MAPS_BROWSER_TIMEOUT=180

VITE_APP_NAME="${APP_NAME}"
